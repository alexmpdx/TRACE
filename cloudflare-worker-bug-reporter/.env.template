# Copy this file to `.env` and fill in both values.
# Both are revocable from their respective dashboards — you can yank them
# the moment we're done deploying.

# Cloudflare API token — generate at https://dash.cloudflare.com/profile/api-tokens
# Scopes needed: Workers Scripts: Edit, Workers Secrets: Edit
CLOUDFLARE_API_TOKEN=

# GitHub fine-grained PAT — generate at https://github.com/settings/personal-access-tokens/new
# Repository access: only alexmpdx/TRACE
# Permissions: Issues: Read and write
GITHUB_PAT_FOR_WORKER=
